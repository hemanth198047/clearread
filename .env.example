# ClearRead published host ports (Compose). Defaults match the Quick start docs.
# Copy to `.env` in the repo root (Compose + start scripts read it) and adjust if local
# ports are already taken. Container-internal ports stay fixed (API 8080, web 80, etc.).

CLEARREAD_API_PORT=8080
CLEARREAD_WEB_PORT=5173
CLEARREAD_KEYCLOAK_PORT=8081
# Keycloak management /health (container :9000). Default 9002 avoids clashing with S3 :9000.
CLEARREAD_KEYCLOAK_MGMT_PORT=9002
# Default 5433 — Windows often already has Postgres (or another service) on 5432.
CLEARREAD_DB_PORT=5433
# Host port for LocalStack S3 (Compose service name is still `minio`).
CLEARREAD_S3_PORT=9000

# Keycloak ready wait (seconds). First boot can take 1–3 minutes on Docker Desktop.
# CLEARREAD_KEYCLOAK_WAIT_SECONDS=240
# Per-dep healthy wait for db / LocalStack (seconds).
# CLEARREAD_DEP_WAIT_SECONDS=90
# Max seconds for each `docker compose up -d <svc>` (v1.0.7+; avoids unbounded hang).
# CLEARREAD_COMPOSE_UP_TIMEOUT=90
# Fail if container Status stays Created this long (Docker Desktop / WSL wedge).
# CLEARREAD_CREATED_STUCK_SECONDS=45

# Optional overrides (start scripts derive these from the ports above when unset)
# VITE_API_BASE_URL=http://localhost:8080
# VITE_OIDC_AUTHORITY=http://localhost:8081/realms/clearread
# CLEARREAD_CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Show admin/user/demo credentials on the landing page (local demo). Set false in production.
# CLEARREAD_SHOW_DEMO_ACCOUNTS=true

# API rate limits (Compose defaults: authenticated unlimited, public edges capped).
# CLEARREAD_API_RPM=0
# CLEARREAD_PUBLIC_API_RPM=120
# Production: CLEARREAD_API_RPM=600 and/or SPRING_PROFILES_ACTIVE=prod

# Optional AI providers (Compose defaults Ollama URL to host.docker.internal:11434).
# Prefer Admin → AI provider connection for runtime URL/model/API key; env is bootstrap/fallback.
# CLEARREAD_AI_OLLAMA_ENABLED=false
# CLEARREAD_AI_OLLAMA_URL=http://host.docker.internal:11434
# CLEARREAD_AI_OLLAMA_MODEL=llama3.2
# CLEARREAD_AI_EXTERNAL_ENABLED=false
# CLEARREAD_AI_EXTERNAL_URL=
# CLEARREAD_AI_EXTERNAL_API_KEY=
# CLEARREAD_AI_EXTERNAL_MODEL=
