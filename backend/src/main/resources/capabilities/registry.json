{
  "registryVersion": "2026.10.4",
  "formats": [
    {
      "formatId": "markdown",
      "displayName": "Markdown",
      "extensions": [".md", ".markdown"],
      "mimeTypes": ["text/markdown", "text/x-markdown"],
      "ingest": "supported",
      "features": {
        "headings": "supported",
        "paragraphs": "supported",
        "lists": "supported",
        "tables": "partial",
        "codeBlocks": "supported",
        "mermaid": "partial",
        "remoteImages": "unsupported",
        "urlIngest": "supported"
      },
      "notes": "GFM pipe tables map to dataTable (no rowspan/colspan). Mermaid fences are kept as source plus a size-limited text outline — diagrams are never executed in the reader.",
      "adapterId": "markdown-commonmark-gfm",
      "adapterVersion": "1.0.1"
    },
    {
      "formatId": "plain-text",
      "displayName": "Plain text",
      "extensions": [".txt", ".text"],
      "mimeTypes": ["text/plain"],
      "ingest": "supported",
      "features": {
        "headings": "partial",
        "paragraphs": "supported",
        "lists": "partial",
        "tables": "unsupported",
        "codeBlocks": "unsupported",
        "remoteImages": "unsupported",
        "urlIngest": "supported"
      },
      "adapterId": "plain-text-heuristic",
      "adapterVersion": "1.0.0"
    },
    {
      "formatId": "json",
      "displayName": "JSON",
      "extensions": [".json"],
      "mimeTypes": ["application/json"],
      "ingest": "supported",
      "features": {
        "tree": "supported",
        "formattedSource": "supported",
        "urlIngest": "supported"
      },
      "adapterId": "json-tree",
      "adapterVersion": "1.0.0"
    },
    {
      "formatId": "yaml",
      "displayName": "YAML",
      "extensions": [".yaml", ".yml"],
      "mimeTypes": ["application/yaml", "text/yaml"],
      "ingest": "supported",
      "features": {
        "tree": "supported",
        "safeParse": "supported",
        "urlIngest": "supported"
      },
      "adapterId": "yaml-safe",
      "adapterVersion": "1.0.0"
    },
    {
      "formatId": "xml",
      "displayName": "XML",
      "extensions": [".xml"],
      "mimeTypes": ["application/xml", "text/xml"],
      "ingest": "supported",
      "features": {
        "tree": "supported",
        "xxeProtected": "supported",
        "urlIngest": "supported"
      },
      "adapterId": "xml-secure",
      "adapterVersion": "1.0.0"
    },
    {
      "formatId": "csv",
      "displayName": "CSV",
      "extensions": [".csv"],
      "mimeTypes": ["text/csv"],
      "ingest": "supported",
      "features": {
        "table": "supported",
        "quotedMultiline": "supported",
        "urlIngest": "supported"
      },
      "adapterId": "csv-table",
      "adapterVersion": "1.0.0"
    },
    {
      "formatId": "tsv",
      "displayName": "TSV",
      "extensions": [".tsv"],
      "mimeTypes": ["text/tab-separated-values"],
      "ingest": "supported",
      "features": {
        "table": "supported",
        "urlIngest": "supported"
      },
      "adapterId": "tsv-table",
      "adapterVersion": "1.0.0"
    },
    {
      "formatId": "log",
      "displayName": "Log",
      "extensions": [".log"],
      "mimeTypes": ["text/plain"],
      "ingest": "supported",
      "features": {
        "lineView": "supported",
        "urlIngest": "supported"
      },
      "adapterId": "log-lines",
      "adapterVersion": "1.0.0"
    },
    {
      "formatId": "config",
      "displayName": "Config / env",
      "extensions": [".ini", ".conf", ".properties", ".env"],
      "mimeTypes": ["text/plain", "text/x-java-properties"],
      "ingest": "supported",
      "features": {
        "keyValue": "partial",
        "secretMasking": "partial",
        "urlIngest": "supported"
      },
      "adapterId": "config-text",
      "adapterVersion": "1.0.0"
    },
    {
      "formatId": "source-code",
      "displayName": "Source code",
      "extensions": [".java", ".ts", ".js", ".py", ".go", ".rs", ".rb", ".kt", ".cs", ".c", ".cpp", ".sh", ".sql"],
      "mimeTypes": ["text/x-java-source", "text/javascript", "text/x-python"],
      "ingest": "supported",
      "features": {
        "lineNumbers": "supported",
        "neverExecute": "supported",
        "urlIngest": "supported"
      },
      "adapterId": "source-code",
      "adapterVersion": "1.0.0"
    },
    {
      "formatId": "html",
      "displayName": "HTML (sanitized file)",
      "extensions": [".html", ".htm"],
      "mimeTypes": ["text/html"],
      "ingest": "supported",
      "features": {
        "sanitized": "supported",
        "remoteFetch": "unsupported",
        "urlIngest": "partial"
      },
      "notes": "Uploaded HTML files are sanitized. URL ingest rejects ordinary web pages (no silent scraping).",
      "adapterId": "html-sanitize",
      "adapterVersion": "1.0.0"
    },
    {
      "formatId": "asciidoc",
      "displayName": "AsciiDoc",
      "extensions": [".adoc", ".asciidoc", ".asc"],
      "mimeTypes": ["text/asciidoc", "text/x-asciidoc"],
      "ingest": "unsupported",
      "features": {
        "headings": "unsupported",
        "includes": "unsupported"
      },
      "notes": "Registered for honesty only — no AsciiDoc parser ships in this release. Convert to Markdown or paste plain text.",
      "adapterId": null,
      "adapterVersion": null
    },
    {
      "formatId": "rst",
      "displayName": "reStructuredText",
      "extensions": [".rst", ".rest"],
      "mimeTypes": ["text/x-rst", "text/rst"],
      "ingest": "unsupported",
      "features": {
        "headings": "unsupported",
        "directives": "unsupported"
      },
      "notes": "Registered for honesty only — no RST parser ships in this release. Convert to Markdown or paste plain text.",
      "adapterId": null,
      "adapterVersion": null
    }
  ],
  "urlIngest": {
    "enabled": true,
    "schemes": ["http", "https"],
    "privateNetwork": "disabled-by-default",
    "webPages": "rejected-with-explanation"
  },
  "exports": {
    "note": "Markdown, sanitized HTML, and constrained text PDF. All exports are generated artifacts (artifactKind=generated), not the immutable original.",
    "converters": [
      {
        "targetFormat": "markdown",
        "converterId": "cleardoc-to-markdown",
        "converterVersion": "1.0.0",
        "artifactKind": "generated"
      },
      {
        "targetFormat": "html",
        "converterId": "cleardoc-to-html-sanitized",
        "converterVersion": "1.0.0",
        "artifactKind": "generated"
      },
      {
        "targetFormat": "pdf",
        "converterId": "cleardoc-to-pdf-constrained",
        "converterVersion": "1.0.0",
        "artifactKind": "generated",
        "notes": "Plain-text layout from ClearDoc only — not a pixel-perfect print engine."
      }
    ]
  }
}
