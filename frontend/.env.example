# Used by Vite (npm run dev) and referenced by Compose web build args.
# Prefer repo-root `.env` for CLEARREAD_*_PORT when using ./scripts/start.sh.

# Empty = same-origin /v1 (Vite proxy in dev; nginx→api in Compose). Recommended.
# Set an absolute URL only for split SPA/API deploys.
VITE_API_BASE_URL=
VITE_OIDC_AUTHORITY=http://localhost:8081/realms/clearread
VITE_OIDC_CLIENT_ID=clearread-spa

# Optional: align Vite dev server / proxy with Compose host ports
# CLEARREAD_API_PORT=8080
# CLEARREAD_WEB_PORT=5173

# VITE_DEV_AUTH_BYPASS=true
